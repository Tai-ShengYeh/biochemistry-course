          "size": 34,
          "at": 0.5,
          "color": "blue",
          "font": "cute",
          "anim": "write",
          "jitter": 0
        }
      ]
    },
    {
      "title": "Vmax 與 Km：各看哪一軸？",
      "narration": "最大速率是曲線漸近的速率上限，單位是濃度除以時間。米氏常數是半最大速率所對應的受質濃度，單位是濃度。",
      "steps": [
        "Vmax：速率的上限",
        "Km：[S] 在 v = Vmax/2 時的值",
        "速率單位 ≠ 濃度單位"
      ],
      "stage": "explain",
      "wait": 1.3,
      "source_slides": [
        6,
        7
      ],
      "items": [
        {
          "type": "text",
