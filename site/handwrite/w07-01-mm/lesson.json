        }
      ]
    },
    {
      "title": "上限是 10，半高在哪裡？",
      "narration": "這個模型的最大速率是十，米氏常數是二。當受質濃度等於二，初速率是多少？",
      "steps": [
        "v = 10 × 2 / (2 + 2)",
        "A：2　B：5　C：10"
      ],
      "stage": "practice",
      "wait": 4,
      "source_slides": [
        6,
        7,
        13
      ],
      "items": [
        {
          "type": "text",
          "text": "Một nửa Vmax",
          "x": 180,
          "y": 265,
          "size": 34,
          "at": 0.5,
          "color": "blue",
          "font": "cute",
          "anim": "write",
          "jitter": 0
        }
      ],
      "pause": true,
      "answer": "B，初速率是5，相對速率單位。"
    },
    {
      "title": "核對：先找半高，再讀橫軸",
      "narration": "代入公式得到五，就是最大速率的一半。如果從圖上找米氏常數，要先找縱軸的半高，再水平到曲線，最後往下讀受質濃度。",
      "steps": [
        "Vmax = 10 → 半高 = 5",
        "v = 5 → [S] = 2",
        "所以 Km = 2"
      ],
