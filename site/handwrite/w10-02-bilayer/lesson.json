  "scenes": [
    {
      "title": "兩親性，不是整個分子都愛水",
      "narration": "典型的雙尾磷脂，有親水的頭部與疏水的尾部。兩親性表示同一分子有不同性質的區域，別把它和整體帶正負電的兩性離子混成一個概念。",
      "steps": [
        "兩親性：有親水與疏水區域",
        "典型磷脂：頭部＋兩條尾部",
        "兩親性 ≠ 兩性離子"
      ],
      "stage": "explain",
      "wait": 1.3,
      "source_slides": [
        3,
        7
      ],
