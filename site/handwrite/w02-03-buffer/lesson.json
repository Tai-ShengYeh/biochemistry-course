  "scenes": [
    {
      "title": "緩衝液：兩個角色一起在",
      "narration": "弱酸和它的共軛鹼，同時存在，就能一起抵抗酸鹼值改變。抵抗改變，不是永遠不變。",
      "steps": [
        "HA：可以給出 H⁺",
        "A⁻：可以接受 H⁺",
        {
          "text": "緩衝液不是 pH 完全不變。",
          "emphasis": "box"
        }
      ],
      "stage": "explain",
      "wait": 1.3,
      "source_slides": [
        14,
