    {
      "title": "加酸，誰來接住 H⁺？",
      "narration": "向這個緩衝液加少量酸。帶來的氫離子，主要由未解離的弱酸，還是共軛鹼接住？",
      "steps": [
        "A：HA",
        "B：A⁻"
      ],
      "stage": "practice",
      "wait": 4,
      "source_slides": [
        15
      ],
      "items": [
        {
          "type": "text",
          "text": "Thêm acid",
          "x": 180,
          "y": 265,
          "size": 34,
          "at": 0.5,
          "color": "blue",
          "font": "cute",
          "anim": "write",
          "jitter": 0
        }
      ],
      "pause": true,
      "answer": "B。A⁻ + H⁺ → HA。"
    },
    {
      "title": "核對：加酸，A⁻ 變 HA",
      "narration": "共軛鹼接住氫離子，變回弱酸。加入的氫沒有消失，而是成為弱酸的一部分。酸鹼值仍會下降，只是通常變化較小。",
      "steps": [
        "A⁻ + H⁺ → HA",
        "A⁻ 減少；HA 增加",
        "H 成為 HA 的一部分。"
      ],
      "stage": "answer",
      "wait": 1.3,
      "source_slides": [
        15
      ],
      "items": [
        {
          "type": "text",
          "text": "A⁻ → HA",
          "x": 180,
          "y": 265,
          "size": 34,
          "at": 0.5,
          "color": "blue",
          "font": "cute",
          "anim": "write",
          "jitter": 0
        }
      ]
    },
    {
      "title": "換成加鹼，誰提供 H⁺？",
      "narration": "現在加入少量氫氧根。緩衝液裡，誰可以提供氫離子，幫忙中和氫氧根？",
      "steps": [
        "A：HA",
        "B：A⁻"
      ],
      "stage": "practice",
      "wait": 4,
      "source_slides": [
        15
      ],
      "items": [
        {
          "type": "text",
          "text": "Thêm base",
          "x": 180,
          "y": 265,
          "size": 34,
          "at": 0.5,
          "color": "blue",
          "font": "cute",
          "anim": "write",
          "jitter": 0
        }
      ],
      "pause": true,
      "answer": "A。HA + OH⁻ → A⁻ + H₂O。"
    },
    {
      "title": "核對：加鹼，HA 變 A⁻",
      "narration": "弱酸提供氫離子，與氫氧根形成水。整體反應可以寫成，弱酸加氫氧根，形成共軛鹼和水。酸鹼值仍可能小幅上升。",
      "steps": [
        "HA + OH⁻ → A⁻ + H₂O",
        "HA 減少；A⁻ 增加",
        "加鹼後，pH 通常小幅上升。"
      ],
      "stage": "answer",
      "wait": 1.3,
      "source_slides": [
        15
      ],
      "items": [
        {
          "type": "text",
          "text": "HA → A⁻",
          "x": 180,
          "y": 265,
          "size": 34,
          "at": 0.5,
          "color": "blue",
          "font": "cute",
          "anim": "write",
          "jitter": 0
        }
      ]
    },
    {
      "title": "比例相等時，pH 約等於 pKa",
      "narration": "在適用的近似下，先看共軛鹼和弱酸的濃度比。兩者相等，比值是一，對數是零。所以 pH 約等於 pKa。",
      "steps": [
        "pH ≈ pKa + log₁₀([A⁻]/[HA])",
        "[A⁻] = [HA] → 比值 1",
        {
          "text": "log₁₀(1)=0 → pH≈pKa",
          "emphasis": "box"
        }
